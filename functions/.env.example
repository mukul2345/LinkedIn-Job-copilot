# JobPilot AI - Cloud Functions Environment Variables
# Copy this to .env and fill in your actual credentials.
# This file (.env) is gitignored and NEVER committed.

# === Payment: Cashfree ===
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
CASHFREE_ENVIRONMENT=sandbox

# === Payment: Razorpay ===
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# === AI Provider ===
AI_PROVIDER=gemini
AI_API_KEY=your-gemini-or-openai-api-key

# === Server-side administration ===
# Comma-separated Firebase Auth emails permitted to receive the admin claim.
# Keep real identities only in functions/.env or managed secret configuration.
ADMIN_EMAILS=admin@example.com

# === Scraper Service (Cloud Run URL) ===
# In production this MUST be the deployed Cloud Run URL, e.g.:
#   SCRAPER_SERVICE_URL=https://jobpilot-scraper-xxxxx-uc.a.run.app
# Leaving it at localhost causes the extension to show
# "Job search service is temporarily down." because Cloud Functions cannot
# reach localhost. Use localhost only for local emulator testing.
SCRAPER_SERVICE_URL=https://jobpilot-scraper-xxxxx-uc.a.run.app
