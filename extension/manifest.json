{
  "manifest_version": 3,
  "name": "JobPilot AI - Multi-Platform Job Assistant",
  "version": "2.0.0",
  "description": "Search, evaluate, and manage job applications across supported platforms with user-controlled automation.",
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.indeed.com/*",
    "https://*.indeed.com/*",
    "https://www.glassdoor.com/*",
    "https://*.glassdoor.com/*",
    "https://firestore.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://us-central1-linkedin-jobcopilot.cloudfunctions.net/*"
  ],
  "action": {
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": [
        "core/constants.js",
        "core/runtime-config.js",
        "modules/shared/errors.js",
        "modules/shared/logger.js",
        "modules/shared/storage-provider.js",
        "modules/shared/message-protocol.js",
        "modules/shared/types.js",
        "modules/shared/api-client.js",
        "modules/shared/validators.js",
        "modules/shared/hash.js",
        "modules/shared/filters.js",
        "modules/search/search-service.js",
        "modules/resume/resume-service.js",
        "modules/fit-score/fit-score-service.js",
        "modules/tracker/tracker-service.js",
        "modules/tracker/tracker-ui.js",
        "modules/visa/visa-service.js",
        "modules/subscription/plan-config.js",
        "modules/database/cache-manager.js",
        "modules/database/firestore-service.js",
        "modules/database/usage-repository.js",
        "modules/subscription/plan-service.js",
        "modules/jobs/job-domain.js",
        "modules/jobs/job-normalizers.js",
        "modules/jobs/job-policy.js",
        "modules/platforms/platform-adapter.js",
        "modules/platforms/linkedin-adapter.js",
        "modules/platforms/platform-registry.js",
        "modules/applications/application-state.js",
        "modules/applications/application-orchestrator.js",
        "modules/applications/application-history-service.js",
        "modules/applications/candidate-profile-snapshot.js",
        "modules/applications/answer-resolver.js",
        "modules/bot/utils.js",
        "modules/bot/selectors.js",
        "ui/components/upgrade-modal.js",
        "modules/ai/ai-provider.js",
        "modules/ai/ai-service.js",
        "modules/bot/form-filler.js",
        "modules/bot/hr-outreach.js",
        "modules/bot/recruiter-msg.js",
        "modules/bot/job-processor.js",
        "modules/bot/safety.js",
        "modules/bot/bot-core.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.indeed.com/*",
        "https://*.indeed.com/*",
        "https://www.glassdoor.com/*",
        "https://*.glassdoor.com/*"
      ],
      "js": [
        "core/constants.js",
        "core/runtime-config.js",
        "modules/shared/errors.js",
        "modules/shared/logger.js",
        "modules/shared/message-protocol.js",
        "modules/shared/api-client.js",
        "modules/jobs/job-domain.js",
        "modules/jobs/ai-match-validator.js",
        "content/job-board-helper.js"
      ],
      "css": ["content/job-board-helper.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
