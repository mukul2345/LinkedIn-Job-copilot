# JobPilot AI - Local/legacy environment template
#
# Deployed Firebase Functions read functions/.env (or managed environment
# configuration), NOT this root file. Use functions/.env.example for quota,
# admin, payment, AI, Gmail, and SCRAPER_SERVICE_URL settings.
# This root template is retained only for root-level/local tooling.
# NEVER commit an actual .env file.

# Local scraper URL for root-level development tools only
SCRAPER_SERVICE_URL=http://localhost:8080

# AI provider: "gemini" or "openai"
AI_PROVIDER=gemini
AI_API_KEY=your-ai-api-key-here

# Optional Chrome extension Gmail OAuth client. When set, `npm run build`
# injects identity permission and Gmail read-only OAuth metadata into dist only.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Legacy Python bot candidate facts. Export these variables before running the
# legacy bot; required facts intentionally have no production defaults.
JOBPILOT_RESUME_PATH="all resumes/default"
JOBPILOT_YEARS_EXPERIENCE=
JOBPILOT_REQUIRE_VISA=
JOBPILOT_WEBSITE=
JOBPILOT_LINKEDIN_URL=
JOBPILOT_WORK_AUTHORIZATION=
JOBPILOT_DESIRED_SALARY=
JOBPILOT_CURRENT_CTC=
JOBPILOT_NOTICE_PERIOD=
JOBPILOT_LINKEDIN_HEADLINE=
JOBPILOT_LINKEDIN_SUMMARY=
JOBPILOT_COVER_LETTER=
JOBPILOT_CANDIDATE_CONTEXT=
JOBPILOT_RECENT_EMPLOYER=
JOBPILOT_CONFIDENCE_LEVEL=
JOBPILOT_PAUSE_BEFORE_SUBMIT=true
JOBPILOT_PAUSE_AT_FAILED_QUESTION=true
JOBPILOT_OVERWRITE_ANSWERS=false


# Legacy Python search input. List values use JSON arrays.
JOBPILOT_SEARCH_TERMS=[]
JOBPILOT_SEARCH_LOCATION=
JOBPILOT_SEARCH_SWITCH_COUNT=5
JOBPILOT_RANDOMIZE_SEARCH=false
JOBPILOT_SORT_BY=
JOBPILOT_DATE_POSTED=
JOBPILOT_SALARY_FILTER=
JOBPILOT_EASY_APPLY_ONLY=true
JOBPILOT_EXPERIENCE_LEVELS=[]
JOBPILOT_JOB_TYPES=[]
JOBPILOT_WORKPLACE_TYPES=[]
JOBPILOT_COMPANIES=[]
JOBPILOT_LOCATION_FILTERS=[]
JOBPILOT_INDUSTRIES=[]
JOBPILOT_JOB_FUNCTIONS=[]
JOBPILOT_JOB_TITLES=[]
JOBPILOT_BENEFITS=[]
JOBPILOT_COMMITMENTS=[]
JOBPILOT_COMPANY_EXCLUDED_WORDS=[]
JOBPILOT_COMPANY_PREFERRED_WORDS=[]
JOBPILOT_JOB_EXCLUDED_WORDS=[]
JOBPILOT_SECURITY_CLEARANCE=
JOBPILOT_DID_MASTERS=
JOBPILOT_CURRENT_EXPERIENCE=