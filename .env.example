# JobPilot AI - Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.

# Scraper service URL (Cloud Run URL after deployment, or localhost for dev)
SCRAPER_SERVICE_URL=http://localhost:8080

# AI provider: "gemini" or "openai"
AI_PROVIDER=gemini
AI_API_KEY=your-ai-api-key-here

# Gmail OAuth (get from Google Cloud Console > APIs & Services > Credentials)
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
