rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== USER DOCUMENTS =====
    match /users/{uid} {
      // Users can read their own document
      allow read: if request.auth != null && request.auth.uid == uid;

      // Users may create only an unprivileged initial document. Privileged
      // fields are assigned exclusively by trusted Cloud Functions/admin SDK.
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.role == 'user'
                    && request.resource.data.plan == 'free'
                    && request.resource.data.planExpiresAt == null
                    && request.resource.data.usage == {};

      // Users can update their own document BUT cannot change role, plan,
      // planExpiresAt, or usage. The usage counters are consumed exclusively by
      // the checkAndConsumeQuota Cloud Function (admin SDK) so clients cannot
      // reset or under-report their own quota.
      allow update: if request.auth != null && request.auth.uid == uid
                    && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
                    && (!('plan' in request.resource.data) || request.resource.data.plan == resource.data.plan)
                    && (!('planExpiresAt' in request.resource.data) || request.resource.data.planExpiresAt == resource.data.planExpiresAt)
                    && (!('usage' in request.resource.data) || request.resource.data.usage == resource.data.usage);

      // Users cannot delete their own doc
      allow delete: if false;
    }

    // ===== SYSTEM COLLECTION =====
    // Sequential counters and other system data are server-owned. The client
    // uses a collision-resistant fallback identifier when this write is denied.
    match /system/{document=**} {
      allow read, write: if false;
    }

    // Backend services own job, resume, tracker, token, and search records.
    // Authenticated users may read their own records but cannot forge writes.
    match /users/{uid}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // ===== ORDERS COLLECTION =====
    // No direct client access — managed by Cloud Functions only
    match /orders/{orderId} {
      allow read, write: if false;
    }

    // ===== ADMIN OVERRIDE =====
    match /{document=**} {
      allow read: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
